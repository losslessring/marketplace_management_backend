generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @default(autoincrement()) @id
  email String @unique
  password String
  applications Application[]
}

model Application {
  id Int @default(autoincrement()) @id
  name String
  description String
  user User @relation(fields: [userId], references: [id])
  userId Int
  nodeTrees NodeTree[]
  connections Connection[]
  nodeData NodeData[]
}

model CoreNode {
  id Int @default(autoincrement()) @id
  name String 
}


model NodeTree {
  id Int @default(autoincrement()) @id
  positionX Int
  positionY Int 
  nodeId Int @unique
  
  nodeData NodeData?
  application Application @relation(fields: [applicationId], references: [id])
  applicationId Int
}

model Connection {
  id Int @default(autoincrement()) @id
  fromId Int 
  toId Int
  application Application @relation(fields: [applicationId], references: [id])
  applicationId Int
}

model NodeData {
  id Int @default(autoincrement()) @id
  nodeDataType String @default("text")
  nodeData String
  node NodeTree @relation(fields: [nodeId], references: [nodeId])
  nodeId Int @unique
  application Application @relation(fields: [applicationId], references: [id])
  applicationId Int
}

